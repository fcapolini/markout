{
  "name": "markout-monorepo",
  "private": true,
  "description": "Workspace root. The published packages live in packages/, and nothing here is published.",
  "workspaces": [
    "packages/*",
    "kits/*",
    "sites/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "build:tailwind": "npm run build:tailwind -w @markout-lang/site",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only && npm run lockfile",
    "release": "npm run build && changeset publish",
    "lockfile": "node scripts/lockfile.mjs",
    "pretest-coverage": "npm run build",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @markout-lang/site",
    "dev:bench": "npm run dev:bench -w @markout-lang/cli --",
    "bench:catalog": "npm run bench:catalog -w @markout-lang/cli --",
    "bench:compare": "npm run bench:compare -w @markout-lang/cli --",
    "start": "npm run start -w @markout-lang/site"
  },
  "author": "Fabrizio Capolini",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
