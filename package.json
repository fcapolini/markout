{
  "name": "markout",
  "version": "0.4.0",
  "description": "HTML-first reactive web framework: lexically scoped values on the DOM tree, compile-time dependency extraction, and isomorphic SSR",
  "bin": {
    "markout": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:runtime",
    "build:runtime": "node scripts/build-runtime.mjs",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts -d ./demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && npm run typecheck:test && npm run typecheck:dom",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:dom": "tsc -p tsconfig.dom.json"
  },
  "keywords": [
    "html",
    "reactive",
    "web-framework",
    "framework",
    "ssr",
    "isomorphic",
    "hydration",
    "templating",
    "compiler"
  ],
  "author": "Fabrizio Capolini <fabrizio.capolini@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/escodegen": "^0.0.10",
    "@types/estraverse": "^5.1.7",
    "@types/estree": "^1.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "commander": "^15.0.0",
    "entities": "^7.0.1",
    "escodegen": "^2.1.0",
    "estraverse": "^5.3.0",
    "express": "^5.2.1"
  }
}
