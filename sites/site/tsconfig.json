// Type-checks the site's own TypeScript -- its server and Orbit's database.
// Not a composite project: nothing depends on the site, it emits nothing,
// and it is never published.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler"
  },
  "include": ["*.ts"]
}
