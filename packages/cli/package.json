{
  "name": "@markout-lang/cli",
  "version": "0.6.0",
  "description": "HTML-first reactive language: lexically scoped values on the DOM tree, compile-time dependency extraction, and isomorphic SSR",
  "repository": {
    "type": "git",
    "url": "https://github.com/fcapolini/markout.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/fcapolini/markout/issues"
  },
  "homepage": "https://markout.dev",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "markout": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsx --tsconfig tsconfig.dev.json src/cli.ts -d ../../demo",
    "dev:bench": "tsx --tsconfig tsconfig.dev.json src/cli.ts -d ./bench",
    "dev:bootstrap-kit": "tsx --tsconfig tsconfig.dev.json ../../kits/bootstrap/server.ts --prod",
    "dev:std-kit": "tsx --tsconfig tsconfig.dev.json src/cli.ts -d ../../kits/std",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && npm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "bench:medium": "node scripts/gen-bench-pages.mjs && tsx --tsconfig tsconfig.dev.json scripts/bench-medium.ts",
    "bench:compare": "tsx --tsconfig tsconfig.dev.json scripts/bench-compare.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "html",
    "reactive",
    "web-framework",
    "framework",
    "ssr",
    "isomorphic",
    "hydration",
    "templating",
    "compiler"
  ],
  "author": "Fabrizio Capolini",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@markout-lang/core": "^0.6.0",
    "@markout-lang/express": "^0.6.0",
    "commander": "^15.0.0",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
