{
  "name": "markout",
  "version": "0.4.0",
  "description": "HTML-first reactive web framework: lexically scoped values on the DOM tree, compile-time dependency extraction, and isomorphic SSR",
  "bin": {
    "markout": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsx --tsconfig tsconfig.dev.json src/cli.ts -d ../../demo",
    "dev:bench": "tsx --tsconfig tsconfig.dev.json src/cli.ts -d ./bench",
    "dev:bootstrap-kit": "tsx --tsconfig tsconfig.dev.json ../../kits/bootstrap/server.ts --prod",
    "dev:std-kit": "tsx --tsconfig tsconfig.dev.json src/cli.ts -d ../../kits/std",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && npm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "bench:medium": "node scripts/gen-bench-pages.mjs && tsx --tsconfig tsconfig.dev.json scripts/bench-medium.ts",
    "bench:compare": "tsx --tsconfig tsconfig.dev.json scripts/bench-compare.ts"
  },
  "keywords": [
    "html",
    "reactive",
    "web-framework",
    "framework",
    "ssr",
    "isomorphic",
    "hydration",
    "templating",
    "compiler"
  ],
  "author": "Fabrizio Capolini",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@markout/core": "^0.4.0",
    "commander": "^15.0.0",
    "compression": "^1.8.1",
    "express": "^5.2.1"
  }
}
