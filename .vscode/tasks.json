{
  "version": "2.0.0",
  "tasks": [
    {
      // the extension host loads packages/vscode/dist, and @markout/core
      // resolves to packages/core/dist -- so both have to be built, which is
      // what the root build does
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "label": "npm: build"
    },
    {
      // what the extension host loads is a BUNDLE now, so a tsc watch alone
      // rebuilds nothing it reads: the two below run together
      "label": "watch: extension",
      "dependsOn": ["watch: types", "watch: bundle"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "npx tsc -b --watch",
      "options": { "cwd": "${workspaceFolder}/packages/vscode" },
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"],
      "label": "watch: types"
    },
    {
      "type": "npm",
      "script": "watch",
      "path": "packages/vscode",
      "isBackground": true,
      "problemMatcher": [],
      "label": "watch: bundle"
    }
  ]
}
